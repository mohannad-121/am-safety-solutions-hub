{
  "trailingSlash": false,
  "buildCommand": "npm run vercel-build",
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "ambs.ae" }], "destination": "https://www.ambs.ae/:path*", "permanent": true },
    { "source": "/standards", "destination": "/standards/en-13374-edge-protection", "permanent": true },
    { "source": "/en-13374-edge-protection", "destination": "/standards/en-13374-edge-protection", "permanent": true },
    { "source": "/bs-en-13374-2025-edge-protection", "destination": "/standards/en-13374-edge-protection", "permanent": true },
    { "source": "/certifications", "destination": "/standards/en-13374-edge-protection", "permanent": true },
    { "source": "/edge-protection-faqs", "destination": "/faq", "permanent": true }
  ],
  "rewrites": [{ "source": "/admin/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
        { "key": "Cache-Control", "value": "private, no-store, max-age=0" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
